# Shopping Agent Configuration
DATABASE_URL=postgresql+asyncpg://postgres:your_password@db.your_ref.supabase.co:5432/postgres
HOST=127.0.0.1
PORT=8000
DEBUG=true
ENABLE_SCHEDULER=true
COLES_API_KEY=your_coles_api_key
WOOLWORTHS_API_KEY=your_woolworths_mobile_api_key
SUPABASE_JWT_SECRET=your-jwt-secret-here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
BASE_URL=https://localhost:8000
MCP_OAUTH_CLIENT_ID=your-mcp-oauth-client-id
MCP_OAUTH_CLIENT_SECRET=your-mcp-oauth-client-secret
# Fallback user UUID for MCP tools (used until OAuth 2.1 flow is configured)
MCP_DEFAULT_USER_ID=
# Persistent Chrome profile for Playwright login (survives Incapsula challenges)
PLAYWRIGHT_PROFILE_DIR=/your/directory
# Set to false to show the browser window during login (useful for debugging)
PLAYWRIGHT_HEADLESS=false
# Use system Chrome locally (better Incapsula bypass); unset on Fly.io to use bundled Chromium
PLAYWRIGHT_CHANNEL=