# Port the shopping-agent FastAPI server listens on.
#
# Single source of truth for the port. This file is rsynced to the mini on
# every deploy and read in two places:
#   - shopping-agent.service, via
#     `EnvironmentFile=-/srv/shopping-agent/deploy/shopping-agent.env`
#   - the "Health check" step in .github/workflows/mac-mini.yml
#
# Secrets (DATABASE_URL, SUPABASE_*, COLES_API_KEY, ...) are NOT here — they
# live in /etc/shopping-agent/env on the mini (untracked, root:andrewsaunders
# 0640) and are loaded first, so this file's PORT overrides any stale value.
PORT=8000
