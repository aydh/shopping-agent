# Canonical systemd unit for the shopping-agent FastAPI server on the Mac mini.
#
# This is the version-controlled reference for what lives at
# /etc/systemd/system/shopping-agent.service on the mini. It is NOT installed
# automatically (that would broaden the runner's sudo scope to write
# /etc/systemd/system and run daemon-reload). Install it by hand once.
#
# The listening port is NOT hardcoded here — it comes from the repo-managed
# EnvironmentFile (deploy/shopping-agent.env), which is rsynced to
# /srv/shopping-agent/deploy/ on every deploy. `Environment=PORT=8000` is
# only a fallback if that file is missing. Change the port in
# deploy/shopping-agent.env, not here.
#
# Secrets are loaded from /etc/shopping-agent/env (untracked, populated once
# by hand).

[Unit]
Description=shopping-agent FastAPI server
After=network.target

[Service]
Type=simple
User=andrewsaunders
WorkingDirectory=/srv/shopping-agent
Environment=PORT=8000
EnvironmentFile=-/etc/shopping-agent/env
EnvironmentFile=-/srv/shopping-agent/deploy/shopping-agent.env
ExecStart=/srv/shopping-agent/.venv/bin/uvicorn shopping_agent.main:app --host 0.0.0.0 --port ${PORT}
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
